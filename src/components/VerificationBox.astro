---
interface Props {
  whatWeKnow: string[];
  whatIsNotConfirmedYet?: string[];
  lang: 'en' | 'ur';
}

const { whatWeKnow, whatIsNotConfirmedYet = [], lang } = Astro.props;
const isUrdu = lang === 'ur';
---

<section aria-labelledby="verification-summary-heading" class="my-8 rounded-xl border border-neutral-800 bg-neutral-900/60 p-5 sm:p-6 shadow-md backdrop-blur-xs">
  <div class="mb-4 flex items-center justify-between border-b border-neutral-800 pb-3">
    <div class="flex items-center gap-2">
      <span class="flex h-3 w-3 items-center justify-center rounded-full bg-red-600">
        <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
      </span>
      <h3 id="verification-summary-heading" class="text-sm font-bold uppercase tracking-wider text-red-500">
        {isUrdu ? 'ادارتی حقائق نامہ' : 'Editorial Fact Briefing'}
      </h3>
    </div>
    <span class="text-xs text-neutral-400">
      {isUrdu ? 'کثیر الجہتی جانچ پڑتال' : 'Multi-Source Cross-Checked'}
    </span>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    <!-- What We Know -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-emerald-400">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        <h4 class="text-xs font-bold uppercase tracking-wider">
          {isUrdu ? 'تصدیق شدہ حقائق (ہمیں کیا معلوم ہے)' : 'What We Know (Established Facts)'}
        </h4>
      </div>
      <ul class="space-y-2 text-xs sm:text-sm text-neutral-300">
        {whatWeKnow.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
            <span class="leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- What Is Not Confirmed Yet -->
    {whatIsNotConfirmedYet && whatIsNotConfirmedYet.length > 0 && (
      <div class="space-y-3 border-t border-neutral-800/80 pt-4 md:border-t-0 md:border-s md:border-neutral-800/80 md:ps-6 md:pt-0">
        <div class="flex items-center gap-2 text-amber-400">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <h4 class="text-xs font-bold uppercase tracking-wider">
            {isUrdu ? 'زیر انتظار / تاحال غیر مصدقہ پہلو' : 'What Is Not Confirmed Yet'}
          </h4>
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-neutral-300">
          {whatIsNotConfirmedYet.map((item) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
