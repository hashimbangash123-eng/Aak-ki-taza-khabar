---
interface Props {
  lang: 'en' | 'ur';
  currentCategory?: string;
  alternateUrl?: string;
}

const { lang, currentCategory, alternateUrl } = Astro.props;
const isUrdu = lang === 'ur';

const categories = [
  { id: 'pakistan', en: 'Pakistan', ur: 'پاکستان' },
  { id: 'politics', en: 'Politics', ur: 'سیاست' },
  { id: 'world', en: 'World', ur: 'عالمی' },
  { id: 'business', en: 'Business', ur: 'معیشت' },
  { id: 'technology', en: 'Technology', ur: 'ٹیکنالوجی' },
  { id: 'cricket', en: 'Cricket', ur: 'کرکٹ' },
  { id: 'football', en: 'Football', ur: 'فٹ بال' },
  { id: 'esports', en: 'Esports', ur: 'ای اسپورٹس' },
  { id: 'health', en: 'Health', ur: 'صحت' },
  { id: 'education', en: 'Education', ur: 'تعلیم' },
  { id: 'crime', en: 'Crime', ur: 'جرائم' }
];

const targetLang = isUrdu ? 'en' : 'ur';
const targetLangLabel = isUrdu ? 'English' : 'اردو';

// Convert full URLs (e.g. https://aajkitazakhabar.pages.dev/ur/about) to relative paths (/ur/about)
// so the language switch works seamlessly on localhost, preview URLs, and production.
function toRelativePath(urlOrPath?: string): string {
  if (!urlOrPath) return `/${targetLang}/`;
  try {
    if (urlOrPath.startsWith('http://') || urlOrPath.startsWith('https://')) {
      const parsed = new URL(urlOrPath);
      return parsed.pathname + parsed.search + parsed.hash;
    }
    return urlOrPath;
  } catch {
    return urlOrPath;
  }
}

const switchHref = toRelativePath(alternateUrl);

const todayFormatted = new Date().toLocaleDateString(isUrdu ? 'ur-PK' : 'en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<header class="w-full bg-[#0a0a0e] border-b border-neutral-800 text-neutral-100 sticky top-0 z-40 backdrop-blur-md bg-opacity-95">
  <!-- Top Bar: Date, Edition, Language, Search -->
  <div class="border-b border-neutral-800/80 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-4">
      <!-- Date & Edition -->
      <div class="flex items-center gap-3 text-neutral-400">
        <span class="font-medium">{todayFormatted}</span>
        <span class="hidden sm:inline text-neutral-500">•</span>
        <span class="hidden sm:inline text-neutral-400">
          {isUrdu ? 'قومی و بین الاقوامی مصدقہ ایڈیشن' : 'Verified Pakistan & World Edition'}
        </span>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-3">
        <!-- Search Trigger Button -->
        <button
          type="button"
          id="open-search-modal"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-700/80 transition-colors text-xs cursor-pointer"
          aria-label={isUrdu ? 'تلاش کھولیں' : 'Open search'}
        >
          <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden xs:inline">{isUrdu ? 'تلاش' : 'Search'}</span>
          <kbd class="hidden md:inline text-[10px] bg-neutral-800 px-1 py-0.5 rounded text-neutral-400 border border-neutral-700">Ctrl K</kbd>
        </button>

        <!-- Language Switcher -->
        <a
          href={switchHref}
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-red-600/10 hover:bg-red-600 text-red-400 hover:text-white border border-red-600/40 transition-all font-semibold text-xs"
          title={isUrdu ? 'Switch to English' : 'اردو میں پڑھیں'}
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span>{targetLangLabel}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Primary Masthead Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={`/${lang}/`} class="group inline-flex flex-col text-neutral-100 hover:text-white">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 sm:w-11 sm:h-11 bg-red-600 rounded-sm flex items-center justify-center text-white font-black text-xl sm:text-2xl shadow-md shadow-red-600/20 group-hover:bg-red-500 transition-colors">
          <span>{isUrdu ? 'آ' : 'A'}</span>
        </div>
        <div>
          <span class="text-xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-1.5 uppercase font-serif">
            {isUrdu ? 'آج کی تازہ خبر' : 'Aaj Ki Taza Khabar'}
          </span>
          <span class="block text-[11px] sm:text-xs text-red-500 font-semibold uppercase tracking-widest">
            {isUrdu ? 'آزاد • مصدقہ • کثیر الجہتی خبر رساں' : 'Independent • Verified Multi-Source Newsroom'}
          </span>
        </div>
      </div>
    </a>

    <!-- Trust Tagline & Transparency Link -->
    <div class="hidden lg:flex flex-col items-end text-xs text-neutral-400">
      <span class="font-medium text-neutral-300">
        {isUrdu ? 'صفر من گھڑت مواد • حقیقی شائع شدہ ذرائع' : 'Zero Synthetic Fiction • 100% Real Sources'}
      </span>
      <a href={`/${lang}/editorial-policy`} class="text-red-400 hover:text-red-300 hover:underline text-[11px] mt-0.5">
        {isUrdu ? 'ادارتی و تصدیقی ضابطہ اخلاق پڑھیں ←' : 'Read Our Editorial & AI Ethics Policy →'}
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      type="button"
      id="mobile-nav-toggle"
      class="lg:hidden p-2 rounded bg-neutral-900 border border-neutral-700 text-neutral-300 hover:text-white"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Category Navigation Bar -->
  <nav aria-label="Category Navigation" class="border-t border-neutral-800 bg-[#07070a] hidden lg:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="flex items-center gap-1 overflow-x-auto py-2 text-xs font-semibold uppercase tracking-wider scrollbar-none">
        <li>
          <a
            href={`/${lang}/`}
            class={`px-3 py-1.5 rounded transition-colors inline-block ${
              !currentCategory
                ? 'bg-red-600 text-white'
                : 'text-neutral-300 hover:text-white hover:bg-neutral-800/60'
            }`}
          >
            {isUrdu ? 'صفحۂ اول' : 'Home'}
          </a>
        </li>
        {categories.map((cat) => {
          const isActive = currentCategory === cat.id;
          return (
            <li>
              <a
                href={`/${lang}/${cat.id}/`}
                class={`px-3 py-1.5 rounded transition-colors inline-block ${
                  isActive
                    ? 'bg-red-600 text-white'
                    : 'text-neutral-300 hover:text-white hover:bg-neutral-800/60'
                }`}
              >
                {cat[lang]}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav-menu" class="hidden lg:hidden border-t border-neutral-800 bg-neutral-950 px-4 py-4 space-y-3">
    <div class="grid grid-cols-2 gap-2 text-xs font-medium">
      <a href={`/${lang}/`} class="p-2 rounded bg-neutral-900 text-white hover:bg-neutral-800">
        {isUrdu ? 'صفحۂ اول' : 'Home'}
      </a>
      {categories.map((cat) => (
        <a
          href={`/${lang}/${cat.id}/`}
          class={`p-2 rounded transition-colors ${
            currentCategory === cat.id ? 'bg-red-600 text-white' : 'bg-neutral-900/60 text-neutral-300 hover:bg-neutral-800'
          }`}
        >
          {cat[lang]}
        </a>
      ))}
    </div>
    <div class="pt-3 border-t border-neutral-800 flex flex-wrap gap-2 text-xs text-neutral-400">
      <a href={`/${lang}/about`} class="hover:text-red-400">{isUrdu ? 'ہمارے متعلق' : 'About'}</a>
      <span>•</span>
      <a href={`/${lang}/editorial-policy`} class="hover:text-red-400">{isUrdu ? 'ادارتی پالیسی' : 'Editorial Policy'}</a>
      <span>•</span>
      <a href={`/${lang}/corrections`} class="hover:text-red-400">{isUrdu ? 'تصحیح کا لاگ' : 'Corrections'}</a>
      <span>•</span>
      <a href={`/${lang}/contact`} class="hover:text-red-400">{isUrdu ? 'رابطہ' : 'Contact'}</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
