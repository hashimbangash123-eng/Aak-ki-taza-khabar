---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'صفحۂ اول', url: 'https://aajkitazakhabar.pages.dev/ur/' },
  { name: 'قانونی دستبرداری', url: 'https://aajkitazakhabar.pages.dev/ur/disclaimer' }
];
---

<BaseLayout
  title="قانونی دستبرداری (Disclaimer) | آج کی تازہ خبر"
  description="خبری مواد، مالیاتی و طبی مشوروں کی نفی اور تیسرے فریق کے بیرونی روابط سے متعلق قانونی وضاحت۔"
  lang="ur"
  canonicalUrl="https://aajkitazakhabar.pages.dev/ur/disclaimer"
  alternateUrl="https://aajkitazakhabar.pages.dev/en/disclaimer"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-3xl mx-auto py-6 space-y-8">
    <header class="border-b border-neutral-800 pb-4">
      <span class="text-xs font-bold text-red-500 uppercase tracking-wider">قانونی وضاحت</span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mt-1">قانونی دستبرداری</h1>
      <p class="text-neutral-400 text-sm mt-2">
        معلوماتی صحافت، بیرونی لنکس اور مشوروں کی نفی سے متعلق اہم قانونی وضاحت۔
      </p>
    </header>

    <div class="prose prose-invert prose-red max-w-none text-neutral-300 leading-relaxed space-y-6 text-sm sm:text-base">
      <h2 class="text-xl font-bold text-white border-b border-neutral-800 pb-2">1. صرف صحافتی مقاصد — کوئی پیشہ ورانہ مشورہ نہیں</h2>
      <p>
        آج کی تازہ خبر پر شائع ہونے والے تمام مضامین، معاشی اعشاریے اور تکنیکی رپورٹس خالصتاً عام معلومات کے لیے ہیں۔ ان معلومات کو مالیاتی سرمایہ کاری، قانونی رائے یا طبی تشخیص کا متبادل نہ سمجھا جائے۔
      </p>

      <h2 class="text-xl font-bold text-white border-b border-neutral-800 pb-2">2. بیرونی لنکس کی ذمہ داری</h2>
      <p>
        رپورٹس میں دیے گئے بیرونی لنکس صرف ماخذ کی شفافیت کے لیے ہیں۔ بیرونی ویب سائٹس پر موجود اشتہارات یا دیگر مواد کی ذمہ داری ان کے اپنے پبلشرز پر عائد ہوتی ہے۔
      </p>
    </div>
  </div>
</BaseLayout>
