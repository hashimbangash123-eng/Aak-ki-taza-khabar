---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'صفحۂ اول', url: 'https://aajkitazakhabar.pages.dev/ur/' },
  { name: 'تصحیح کی پالیسی', url: 'https://aajkitazakhabar.pages.dev/ur/corrections-policy' }
];
---

<BaseLayout
  title="پالیسی برائے تصحیح و درستگی | آج کی تازہ خبر"
  description="غلطیوں کے فوری اعتراف، عوامی لاگ میں اندراج اور قارئین کے سامنے جوابدہی کا باضابطہ طریقہ کار۔"
  lang="ur"
  canonicalUrl="https://aajkitazakhabar.pages.dev/ur/corrections-policy"
  alternateUrl="https://aajkitazakhabar.pages.dev/en/corrections-policy"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-3xl mx-auto py-6 space-y-8">
    <header class="border-b border-neutral-800 pb-4">
      <span class="text-xs font-bold text-red-500 uppercase tracking-wider">شفافیت اور جوابدہی</span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mt-1">پالیسی برائے تصحیح و حقائق کی درستگی</h1>
      <p class="text-neutral-400 text-sm mt-2">
        ہم غلطیوں کو چھپاتے نہیں بلکہ عوامی ریکارڈ پر لا کر فوری اور شفاف تصحیح کرتے ہیں۔
      </p>
    </header>

    <div class="prose prose-invert prose-red max-w-none text-neutral-300 leading-relaxed space-y-6 text-sm sm:text-base">
      <p>
        آج کی تازہ خبر میں قارئین کا اعتماد ہی ہمارا سب سے قیمتی اثاثہ ہے۔ اگر غیر ارادی طور پر کسی خبر میں کوئی غلطی، غلط عدد یا نام شائع ہو جائے تو ہم خاموشی سے خبر تبدیل کرنے کے بجائے کھلے دل سے غلطی کا اعتراف اور درستگی کرتے ہیں۔
      </p>

      <h2 class="text-xl font-bold text-white border-b border-neutral-800 pb-2">1. تصحیح کا باضابطہ طریقہ</h2>
      <ul class="space-y-2 list-disc pe-5">
        <li>
          <strong>خبر کے اندر واضح نوٹس:</strong> متعلقہ خبر کے نیچے نمایاں باکس میں تاریخ، اصل غلط بیان اور تصحیح شدہ حقیقت درج کی جاتی ہے۔
        </li>
        <li>
          <strong>عوامی تصحیحی لاگ:</strong> تمام چھوٹی بڑی تصحیحات ہمارے <a href="/ur/corrections" class="text-red-400 underline">عوامی لاگ (Corrections Log)</a> میں مستقل طور پر محفوظ رہتی ہیں۔
        </li>
      </ul>

      <h2 class="text-xl font-bold text-white border-b border-neutral-800 pb-2">2. قارئین کی طرف سے نشاندہی</h2>
      <p>
        ہر خبر کے نیچے ایک مخصوص لنک دیا گیا ہے جس پر کلک کر کے قارئین کسی بھی غلطی کی نشاندہی کر سکتے ہیں۔ ہماری ادارتی ٹیم 24 گھنٹے کے اندر شواہد کا ازسرنو جائزہ لیتی ہے۔
      </p>
      <p>
        براہ راست ای میل رابطہ: <code>corrections@aajkitazakhabar.pages.dev</code>
      </p>
    </div>
  </div>
</BaseLayout>
