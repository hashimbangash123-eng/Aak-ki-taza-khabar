---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'صفحۂ اول', url: 'https://aajkitazakhabar.pages.dev/ur/' },
  { name: 'استعمال کی شرائط', url: 'https://aajkitazakhabar.pages.dev/ur/terms' }
];
---

<BaseLayout
  title="استعمال کی شرائط (Terms of Service) | آج کی تازہ خبر"
  description="مواد کے استعمال، نقل و اشاعت کے قانونی ضوابط اور کاپی رائٹ کی شرائط۔"
  lang="ur"
  canonicalUrl="https://aajkitazakhabar.pages.dev/ur/terms"
  alternateUrl="https://aajkitazakhabar.pages.dev/en/terms"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-3xl mx-auto py-6 space-y-8">
    <header class="border-b border-neutral-800 pb-4">
      <span class="text-xs font-bold text-red-500 uppercase tracking-wider">قانونی ضوابط</span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mt-1">استعمال کی شرائط</h1>
      <p class="text-neutral-400 text-sm mt-2">
        آج کی تازہ خبر کے مضامین اور مواد سے استفادہ کرنے کے قانونی اصول۔
      </p>
    </header>

    <div class="prose prose-invert prose-red max-w-none text-neutral-300 leading-relaxed space-y-6 text-sm sm:text-base">
      <h2 class="text-xl font-bold text-white border-b border-neutral-800 pb-2">1. مواد کا جائز استعمال</h2>
      <p>
        ہمارے تجزیاتی اور خبری مضامین سے اقتباسات نقل کرنے کی اجازت ہے، بشرطیکہ اصل خبر کے لنک کے ساتھ "آج کی تازہ خبر" کا نام واضح طور پر کریڈٹ دیا جائے۔
      </p>

      <h2 class="text-xl font-bold text-white border-b border-neutral-800 pb-2">2. غیر مجاز نقل</h2>
      <p>
        پوری کی پوری ویب سائٹ یا تمام خبروں کو خودکار سافٹ ویئر کے ذریعے چوری کرنا یا غیر قانونی طور پر دوبارہ شائع کرنا قانونی خلاف ورزی تصور ہوگا۔
      </p>
    </div>
  </div>
</BaseLayout>
