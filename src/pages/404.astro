---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | Aaj Ki Taza Khabar"
  description="The requested news article or category page could not be located."
  lang="en"
>
  <div class="py-20 text-center max-w-xl mx-auto space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-600/20 text-red-500 border border-red-600/30 font-black text-2xl">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-white">Page Not Found</h1>
    <p class="text-neutral-400 text-sm leading-relaxed">
      The story or section you are seeking may have been moved, updated, or does not exist.
      You can return to the homepage or search our verified archives.
    </p>
    <div class="pt-4 flex items-center justify-center gap-4">
      <a
        href="/en/"
        class="px-5 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider transition-colors"
      >
        English Home
      </a>
      <a
        href="/ur/"
        class="px-5 py-2.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 text-white border border-neutral-700 font-bold text-xs transition-colors"
      >
        اردو صفحۂ اول
      </a>
    </div>
  </div>
</BaseLayout>
