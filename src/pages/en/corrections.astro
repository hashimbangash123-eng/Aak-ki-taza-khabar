---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allCorrections = await getCollection('corrections');
allCorrections.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const breadcrumbs = [
  { name: 'Home', url: 'https://aajkitazakhabar.pages.dev/en/' },
  { name: 'Public Corrections Log', url: 'https://aajkitazakhabar.pages.dev/en/corrections' }
];
---

<BaseLayout
  title="Public Corrections & Retractions Log | Aaj Ki Taza Khabar"
  description="Transparent and permanent public record of all factual corrections and amendments across our news coverage."
  lang="en"
  canonicalUrl="https://aajkitazakhabar.pages.dev/en/corrections"
  alternateUrl="https://aajkitazakhabar.pages.dev/ur/corrections"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto py-6 space-y-8">
    <header class="border-b border-neutral-800 pb-4">
      <span class="text-xs font-bold text-red-500 uppercase tracking-wider">Newsroom Transparency</span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mt-1">Public Corrections Log</h1>
      <p class="text-neutral-400 text-sm mt-2">
        A chronological archive of all verified amendments and factual updates.
      </p>
    </header>

    {allCorrections.length > 0 ? (
      <div class="space-y-6">
        {allCorrections.map((entry) => (
          <article class="p-5 sm:p-6 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-4">
            <div class="flex items-center justify-between border-b border-neutral-800 pb-3 flex-wrap gap-2 text-xs">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-red-950 text-red-400 border border-red-800/50 font-bold uppercase text-[10px]">
                  {entry.data.category}
                </span>
                <span class="font-mono text-neutral-400">Ref: {entry.data.id}</span>
              </div>
              <time class="text-neutral-400 font-mono">
                {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>

            <div>
              <h2 class="text-base sm:text-lg font-bold text-white">
                <a
                  href={`/en/${entry.data.category}/${entry.data.articleId}/`}
                  class="hover:text-red-400 transition-colors underline underline-offset-2"
                >
                  {entry.data.articleTitleEn}
                </a>
              </h2>
              <p class="text-xs text-neutral-400 mt-1">
                <strong>Reason:</strong> {entry.data.reason}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs pt-2">
              <div class="p-3 rounded bg-red-950/20 border border-red-900/40 space-y-1">
                <span class="font-bold text-red-400 uppercase tracking-wider text-[10px] block">
                  Original Statement:
                </span>
                <p class="text-neutral-300 leading-relaxed">{entry.data.originalStatementEn}</p>
              </div>

              <div class="p-3 rounded bg-emerald-950/20 border border-emerald-900/40 space-y-1">
                <span class="font-bold text-emerald-400 uppercase tracking-wider text-[10px] block">
                  Rectified Factual Record:
                </span>
                <p class="text-neutral-300 leading-relaxed">{entry.data.correctedStatementEn}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="p-12 text-center text-neutral-400 border border-neutral-800 rounded-xl">
        <p>No corrections logged to date. Our dual-pass verification pipeline is active.</p>
      </div>
    )}
  </div>
</BaseLayout>
